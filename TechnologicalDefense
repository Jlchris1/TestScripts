--[[
NEXUS DEFENSE - ONE-FILE INSTALLER
Run this whole file in the Roblox Studio Command Bar while NOT play-testing.
It creates/updates:
  ServerScriptService.NexusDefenseServer
  StarterPlayer.StarterPlayerScripts.NexusDefenseClient

The generated server only processes projectiles explicitly tagged by your game
with CollectionService tag "NexusThreatProjectile". See setup notes in chat.
]]

local ServerScriptService = game:GetService("ServerScriptService")
local StarterPlayer = game:GetService("StarterPlayer")
local CollectionService = game:GetService("CollectionService")

local serverSource = [====[
-- NEXUS DEFENSE SERVER
-- Generated by NexusDefenseInstaller.lua

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local TAG = "NexusThreatProjectile"
local SHIELD_RADIUS = 200
local DEFLECT_RADIUS = 80
local QUARANTINE_RADIUS = 35
local DODGE_RADIUS = 18
local DODGE_DISTANCE = 14
local DODGE_COOLDOWN = 2
local PROTECTION_DURATION = 1.2
local SCAN_INTERVAL = 0.12

local function getOrCreate(parent, className, name)
    local object = parent:FindFirstChild(name)
    if object and not object:IsA(className) then
        object:Destroy()
        object = nil
    end
    if not object then
        object = Instance.new(className)
        object.Name = name
        object.Parent = parent
    end
    return object
end

local defenseEvent = getOrCreate(ReplicatedStorage, "RemoteEvent", "NexusDefenseRemote")
local fxEvent = getOrCreate(ReplicatedStorage, "RemoteEvent", "NexusDefenseFX")
local quarantineFolder = getOrCreate(ServerStorage, "Folder", "NexusQuarantine")

local validModes = { Shield = true, Deflect = true, Quarantine = true, Dodge = true }
local states = {}
local lastToggle = {}
local lastDodge = {}
local lastShieldFX = {}
local lastDeflect = {}
local motionSamples = setmetatable({}, { __mode = "k" })

local function newState()
    return { Shield = false, Deflect = false, Quarantine = false, Dodge = false }
end

local function ensureState(player)
    if not states[player] then states[player] = newState() end
    return states[player]
end

Players.PlayerAdded:Connect(ensureState)
Players.PlayerRemoving:Connect(function(player)
    states[player] = nil
    lastToggle[player] = nil
    lastDodge[player] = nil
    lastShieldFX[player] = nil
end)
for _, player in ipairs(Players:GetPlayers()) do ensureState(player) end

defenseEvent.OnServerEvent:Connect(function(player, mode, value)
    if not validModes[mode] or typeof(value) ~= "boolean" then return end
    local now = os.clock()
    if now - (lastToggle[player] or 0) < 0.08 then return end
    lastToggle[player] = now
    ensureState(player)[mode] = value
end)

local function getRoot(character)
    if not character then return nil end
    local root = character:FindFirstChild("HumanoidRootPart")
    if root and root:IsA("BasePart") then return root end
    return character.PrimaryPart
end

local function getProjectilePart(object)
    if object:IsA("BasePart") then return object end
    if object:IsA("Model") then
        local part = object.PrimaryPart or object:FindFirstChild("HumanoidRootPart")
            or object:FindFirstChildWhichIsA("BasePart", true)
        if part and part:IsA("BasePart") then return part end
    end
    return nil
end

local function sampleVelocity(part, now)
    local previous = motionSamples[part]
    local velocity = part.AssemblyLinearVelocity
    if previous then
        local dt = math.max(now - previous.time, 0.03)
        local sampled = (part.Position - previous.position) / dt
        if part.Anchored or (velocity.Magnitude < 0.5 and sampled.Magnitude > velocity.Magnitude) then
            velocity = sampled
        end
    elseif part.Anchored then
        velocity = Vector3.zero
    end
    motionSamples[part] = { position = part.Position, time = now }
    return velocity
end

local function isIncoming(part, projectileVelocity, playerRoot)
    local offset = part.Position - playerRoot.Position
    local relativeVelocity = projectileVelocity - playerRoot.AssemblyLinearVelocity
    local distance = offset.Magnitude
    if distance <= 10 then return true, distance end
    local speedSquared = relativeVelocity:Dot(relativeVelocity)
    if speedSquared < 0.01 then return false, distance end
    local closestTime = -offset:Dot(relativeVelocity) / speedSquared
    if closestTime < 0 or closestTime > 2.5 then return false, distance end
    local closestOffset = offset + relativeVelocity * closestTime
    return closestOffset.Magnitude <= 8, distance
end

local function quarantineProjectile(object)
    if not object or not object.Parent or not object:IsDescendantOf(Workspace) then return false end
    CollectionService:RemoveTag(object, TAG)
    local ok = pcall(function()
        object:SetAttribute("NexusNeutralized", true)
        object.Parent = quarantineFolder
    end)
    if not ok or object.Parent ~= quarantineFolder then return false end
    Debris:AddItem(object, 5)
    return true
end

local function deflectProjectile(object, part, playerRoot, now)
    if part.Anchored or not part:IsDescendantOf(Workspace) then return false end
    if now - (lastDeflect[object] or 0) < 0.65 then return false end
    local away = part.Position - playerRoot.Position
    if away.Magnitude < 0.01 then away = Vector3.new(1, 0.35, 0) end
    away = away.Unit
    lastDeflect[object] = now
    pcall(function() part:SetNetworkOwner(nil) end)
    local speed = math.max(part.AssemblyLinearVelocity.Magnitude, 90)
    return pcall(function()
        part.AssemblyLinearVelocity = away * speed + Vector3.new(0, 20, 0)
    end)
end

local function tryDodge(player, threatPosition, threatObject, now)
    if now - (lastDodge[player] or 0) < DODGE_COOLDOWN then return false end
    local character = player.Character
    local root = getRoot(character)
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not character or not root or not humanoid or humanoid.Health <= 0 then return false end

    local away = root.Position - threatPosition
    away = Vector3.new(away.X, 0, away.Z)
    if away.Magnitude < 0.01 then away = Vector3.new(1, 0, 0) else away = away.Unit end
    local sideways = Vector3.new(-away.Z, 0, away.X)
    local directions = { away, sideways, -sideways, (away + sideways).Unit, (away - sideways).Unit }

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = { character, threatObject }
    rayParams.IgnoreWater = true

    for _, direction in ipairs(directions) do
        local delta = direction * DODGE_DISTANCE
        if not Workspace:Raycast(root.Position, delta, rayParams) then
            local candidate = root.Position + delta
            local floorHit = Workspace:Raycast(candidate + Vector3.new(0, 7, 0), Vector3.new(0, -22, 0), rayParams)
            if floorHit then
                local safePosition = Vector3.new(
                    candidate.X,
                    floorHit.Position.Y + humanoid.HipHeight + root.Size.Y / 2,
                    candidate.Z
                )
                lastDodge[player] = now
                character:PivotTo(character:GetPivot() + (safePosition - root.Position))
                local field = Instance.new("ForceField")
                field.Name = "NexusDodgeProtection"
                field.Visible = true
                field.Parent = character
                Debris:AddItem(field, PROTECTION_DURATION)
                fxEvent:FireClient(player, "Dodge", safePosition)
                return true
            end
        end
    end
    return false
end

local function creatorUserId(object, part)
    local id = object:GetAttribute("CreatorUserId")
    if typeof(id) ~= "number" then id = part:GetAttribute("CreatorUserId") end
    return id
end

local function processProjectile(object, now)
    if not object.Parent or not object:IsDescendantOf(Workspace) then return end
    if object:GetAttribute("NexusNeutralized") == true then return end
    local part = getProjectilePart(object)
    if not part or not part:IsDescendantOf(Workspace) then return end

    local velocity = sampleVelocity(part, now)
    local creatorId = creatorUserId(object, part)

    for _, player in ipairs(Players:GetPlayers()) do
        local state = ensureState(player)
        local root = getRoot(player.Character)
        if not root then continue end
        if creatorId == player.UserId then continue end

        local incoming, distance = isIncoming(part, velocity, root)
        local foreignNearby = typeof(creatorId) == "number"
            and creatorId ~= player.UserId
            and not part.Anchored
            and distance <= QUARANTINE_RADIUS

        if not incoming and not foreignNearby then continue end

        local shieldPiercing = object:GetAttribute("ShieldPiercing") == true
            or part:GetAttribute("ShieldPiercing") == true

        if state.Shield and distance <= SHIELD_RADIUS and not shieldPiercing then
            if now - (lastShieldFX[player] or 0) > 0.8 then
                lastShieldFX[player] = now
                fxEvent:FireClient(player, "Shield", root.Position)
            end
            if quarantineProjectile(object) then return end
            -- If server quarantine fails, continue through fallback options.
        end

        if state.Deflect and distance <= DEFLECT_RADIUS then
            if deflectProjectile(object, part, root, now) then return end
        end

        if state.Quarantine and distance <= QUARANTINE_RADIUS then
            if quarantineProjectile(object) then return end
        end

        if state.Dodge and distance <= DODGE_RADIUS then
            if tryDodge(player, part.Position, object, now) then return end
        end
    end
end

local elapsed = 0
RunService.Heartbeat:Connect(function(dt)
    elapsed += dt
    if elapsed < SCAN_INTERVAL then return end
    elapsed = 0
    local now = os.clock()
    for _, object in ipairs(CollectionService:GetTagged(TAG)) do
        processProjectile(object, now)
    end
end)

print("[NEXUS] Defense server ready. Registered projectiles only.")
]====]

local clientSource = [====[
-- NEXUS DEFENSE CLIENT
-- Generated by NexusDefenseInstaller.lua

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local defenseEvent = ReplicatedStorage:WaitForChild("NexusDefenseRemote")
local fxEvent = ReplicatedStorage:WaitForChild("NexusDefenseFX")

local CYAN = Color3.fromRGB(105, 220, 255)
local BLUE = Color3.fromRGB(35, 115, 160)
local PANEL = Color3.fromRGB(5, 14, 27)
local WHITE = Color3.fromRGB(225, 240, 255)

local modes = {
    { key = "Shield", text = "01  FORCEFIELD" },
    { key = "Deflect", text = "02  DEFLECT" },
    { key = "Quarantine", text = "03  QUARANTINE" },
    { key = "Dodge", text = "04  AUTO-DODGE" },
}
local enabled = { Shield = false, Deflect = false, Quarantine = false, Dodge = false }

local oldGui = playerGui:FindFirstChild("NexusDefenseControls")
if oldGui then oldGui:Destroy() end

local gui = Instance.new("ScreenGui")
gui.Name = "NexusDefenseControls"
gui.ResetOnSpawn = false
gui.DisplayOrder = 1000
gui.Parent = playerGui

local panel = Instance.new("Frame")
panel.Name = "DefensePanel"
panel.AnchorPoint = Vector2.new(0, 0.5)
panel.Position = UDim2.new(0, 12, 0.5, 0)
panel.Size = UDim2.fromOffset(190, 204)
panel.BackgroundColor3 = PANEL
panel.BackgroundTransparency = 0.08
panel.BorderSizePixel = 0
panel.Parent = gui

local outline = Instance.new("UIStroke")
outline.Color = BLUE
outline.Thickness = 1
outline.Parent = panel

local function label(text, position, size, color, textSize)
    local item = Instance.new("TextLabel")
    item.BackgroundTransparency = 1
    item.Position = position
    item.Size = size
    item.Font = Enum.Font.Code
    item.Text = text
    item.TextColor3 = color
    item.TextSize = textSize
    item.TextXAlignment = Enum.TextXAlignment.Left
    item.Parent = panel
    return item
end

label("NEXUS // DEFENSE", UDim2.fromOffset(7, 5), UDim2.new(1, -14, 0, 28), CYAN, 14)
local status = label("SYSTEMS ACTIVE: 0 / 4", UDim2.fromOffset(7, 32), UDim2.new(1, -14, 0, 20), WHITE, 10)

local buttons = {}
local function updateStatus()
    local count = 0
    for _, value in pairs(enabled) do if value then count += 1 end end
    status.Text = string.format("SYSTEMS ACTIVE: %d / 4", count)
    status.TextColor3 = count > 0 and CYAN or WHITE
end

for index, item in ipairs(modes) do
    local button = Instance.new("TextButton")
    button.Name = item.key .. "Toggle"
    button.Position = UDim2.fromOffset(7, 57 + (index - 1) * 34)
    button.Size = UDim2.new(1, -14, 0, 29)
    button.BackgroundColor3 = Color3.fromRGB(12, 25, 40)
    button.BorderSizePixel = 0
    button.AutoButtonColor = true
    button.Active = true
    button.Selectable = true
    button.Font = Enum.Font.Code
    button.TextSize = 11
    button.TextXAlignment = Enum.TextXAlignment.Left
    button.Parent = panel

    local line = Instance.new("UIStroke")
    line.Color = BLUE
    line.Thickness = 1
    line.Parent = button

    buttons[item.key] = button
    button:SetAttribute("BaseText", item.text)

    local function repaint()
        local active = enabled[item.key]
        button.TextColor3 = active and CYAN or WHITE
        button.BackgroundColor3 = active and Color3.fromRGB(14, 54, 73)
            or Color3.fromRGB(12, 25, 40)
        button.Text = item.text .. (active and "  [ON]" or "  [OFF]")
    end
    repaint()

    button.Activated:Connect(function()
        enabled[item.key] = not enabled[item.key]
        repaint()
        updateStatus()
        defenseEvent:FireServer(item.key, enabled[item.key])
    end)
end

local effectFolder = Workspace:FindFirstChild("_NexusDefenseVisuals")
if not effectFolder then
    effectFolder = Instance.new("Folder")
    effectFolder.Name = "_NexusDefenseVisuals"
    effectFolder.Parent = Workspace
end

local function expandSphere(position, initialDiameter, finalDiameter, duration)
    local sphere = Instance.new("Part")
    sphere.Name = "NexusDefenseSphere"
    sphere.Shape = Enum.PartType.Ball
    sphere.Size = Vector3.new(initialDiameter, initialDiameter, initialDiameter)
    sphere.CFrame = CFrame.new(position)
    sphere.Anchored = true
    sphere.CanCollide = false
    sphere.CanTouch = false
    sphere.CanQuery = false
    sphere.CastShadow = false
    sphere.Material = Enum.Material.ForceField
    sphere.Color = CYAN
    sphere.Transparency = 0.76
    sphere.Parent = effectFolder

    TweenService:Create(sphere, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = Vector3.new(finalDiameter, finalDiameter, finalDiameter),
        Transparency = 1,
    }):Play()
    Debris:AddItem(sphere, duration + 0.3)
end

fxEvent.OnClientEvent:Connect(function(effectName, position)
    if typeof(position) ~= "Vector3" then return end
    if effectName == "Shield" then
        -- 400-stud diameter = 200-stud radius. Visual only; server handles interception.
        expandSphere(position, 4, 400, 0.8)
        expandSphere(position, 2, 360, 0.72)
    elseif effectName == "Dodge" then
        expandSphere(position, 2, 32, 0.35)
    end
end)

updateStatus()
print("[NEXUS] Defense controls ready.")
]====]

local function replaceSource(parent, className, name, source)
    local scriptObject = parent:FindFirstChild(name)
    if scriptObject and not scriptObject:IsA(className) then
        scriptObject:Destroy()
        scriptObject = nil
    end
    if not scriptObject then
        scriptObject = Instance.new(className)
        scriptObject.Name = name
        scriptObject.Parent = parent
    end
    scriptObject.Source = source
    scriptObject.Disabled = false
    return scriptObject
end

local starterPlayerScripts = StarterPlayer:WaitForChild("StarterPlayerScripts")
replaceSource(ServerScriptService, "Script", "NexusDefenseServer", serverSource)
replaceSource(starterPlayerScripts, "LocalScript", "NexusDefenseClient", clientSource)

print("[NEXUS] Installed/updated NexusDefenseServer and NexusDefenseClient.")
print("[NEXUS] Next: tag your own server-created projectile with 'NexusThreatProjectile' and set its CreatorUserId attribute.")
